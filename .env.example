# === (docker-compose.yml) ===

# Database directory (host path, read-only on VPS)
DB_DIR=/path/to/db

# Posts directory (host path, contains markdown articles, read-only on VPS)
POSTS_DIR=/path/to/posts

# === (docker-compose.watcher.yml) ===

# AI service for auto-tagging/summary (used by watcher)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini