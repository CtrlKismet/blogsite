# === (docker-compose.yml) ===

# Database directory (host ABSOLUTE path, do NOT use ~)
DB_DIR=/path/to/db

# Posts directory (host ABSOLUTE path, do NOT use ~)
# Also the watch path registered with remote-file-notifier client.
# Container mount target defaults to /data/posts (override via POSTS_MOUNT).
POSTS_DIR=/path/to/posts
