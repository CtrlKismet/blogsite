# Local Docker Compose configuration (copy to .env)

# Public hostname for Traefik routing; replace with your own domain
BLOG_DOMAIN=blog.example.com

# Database directory (host ABSOLUTE path, do NOT use ~)
DB_DIR=/path/to/db

# Posts directory (host ABSOLUTE path, do NOT use ~)
# Also the watch path registered with remote-file-notifier client.
# Container mount target defaults to /data/posts (override via POSTS_MOUNT).
POSTS_DIR=/path/to/posts

# Optional watcher image host mappings (comma-separated public_origin=internal_base)
# Example: IMAGE_URL_REWRITES=https://images.example.com=http://image-host:8080
IMAGE_URL_REWRITES=
